<Window x:Class="UP01_523_Ilamakov_Payment.ChartWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
        Title="Диаграмма платежей по категориям"
        Height="500" Width="700"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}"
         Icon="/res/wallet_icon.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Сумма платежей по категориям"
                   FontSize="18" FontWeight="Bold"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,15" Grid.Row="0"/>

        <lvc:CartesianChart Grid.Row="1" LegendLocation="Right">
            <lvc:CartesianChart.Series>
                <lvc:ColumnSeries Title="Сумма" Values="{Binding Values}" DataLabels="True"/>
            </lvc:CartesianChart.Series>
            <lvc:CartesianChart.AxisX>
                <lvc:Axis Title="Категории" Labels="{Binding Labels}"/>
            </lvc:CartesianChart.AxisX>
            <lvc:CartesianChart.AxisY>
                <lvc:Axis Title="Сумма (руб.)"/>
            </lvc:CartesianChart.AxisY>
        </lvc:CartesianChart>

        <Button Content="Закрыть" Width="120" HorizontalAlignment="Right"
                Grid.Row="2" Margin="0,15,0,0" Click="ButtonClose_Click"/>
    </Grid>
</Window>