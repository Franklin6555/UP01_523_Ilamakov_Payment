<Window x:Class="UP01_523_Ilamakov_Payment.PaymentEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Платёж" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
         Icon="/res/wallet_icon.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Добавление платежа"
                   FontSize="18" FontWeight="Bold"
                   Margin="0,0,0,20" Grid.Row="0"/>

        <!-- Пользователь -->
        <Label Content="Пользователь" Grid.Row="1"/>
        <ComboBox x:Name="ComboBoxUser" Grid.Row="2"
                  DisplayMemberPath="FIO" SelectedValuePath="ID"
                  Height="34" Margin="0,0,0,10"/>

        <!-- Категория -->
        <Label Content="Категория" Grid.Row="3"/>
        <ComboBox x:Name="ComboBoxCategory" Grid.Row="4"
                  DisplayMemberPath="Name" SelectedValuePath="ID"
                  Height="34" Margin="0,0,0,10"/>

        <!-- Название -->
        <Label Content="Название платежа" Grid.Row="5"/>
        <TextBox x:Name="TextBoxName" Grid.Row="6" Height="34" Margin="0,0,0,10"/>

        <!-- Дата -->
        <Label Content="Дата" Grid.Row="7"/>
        <DatePicker x:Name="DatePickerDate" Grid.Row="8" Height="34" Margin="0,0,0,10"/>

        <!-- Количество и Цена -->
        <StackPanel Orientation="Horizontal" Grid.Row="9" Margin="0,0,0,20">
            <StackPanel>
                <Label Content="Количество"/>
                <TextBox x:Name="TextBoxNum" Width="150" Height="34"/>
            </StackPanel>
            <StackPanel Margin="20,0,0,0">
                <Label Content="Цена"/>
                <TextBox x:Name="TextBoxPrice" Width="150" Height="34"/>
            </StackPanel>
        </StackPanel>

        <!-- Кнопки -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="11">
            <Button Content="Сохранить" Width="120" Click="ButtonSave_Click"/>
        </StackPanel>
    </Grid>
</Window>