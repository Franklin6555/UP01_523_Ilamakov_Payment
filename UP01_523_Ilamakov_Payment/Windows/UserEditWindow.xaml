<Window x:Class="UP01_523_Ilamakov_Payment.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Пользователь" Height="480" Width="420"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BackgroundBrush}"
         Icon="/res/wallet_icon.ico">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Добавление пользователя"
                   FontSize="18" FontWeight="Bold" Margin="0,0,0,15" Grid.Row="0"/>

        <Label Content="ФИО" Grid.Row="1"/>
        <TextBox x:Name="TextBoxFIO" Grid.Row="2" Height="34" Margin="0,0,0,10"/>

        <Label Content="Логин" Grid.Row="3"/>
        <TextBox x:Name="TextBoxLogin" Grid.Row="4" Height="34" Margin="0,0,0,10"/>

        <Label Content="Пароль" Grid.Row="5"/>
        <PasswordBox x:Name="PasswordBox" Grid.Row="6" Height="34" Margin="0,0,0,10"/>

        <Label Content="Роль" Grid.Row="7"/>
        <ComboBox x:Name="ComboBoxRole" Grid.Row="8" Height="34" Margin="0,0,0,20">
            <ComboBoxItem Content="User"/>
            <ComboBoxItem Content="Admin"/>
        </ComboBox>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Grid.Row="9">
            <Button Content="Сохранить" Width="120" Click="ButtonSave_Click"/>
            <Button Content="Отмена" Width="100" Margin="10,0,0,0"
                    Background="{StaticResource GrayBrush}" Click="ButtonCancel_Click"/>
        </StackPanel>
    </Grid>
</Window>