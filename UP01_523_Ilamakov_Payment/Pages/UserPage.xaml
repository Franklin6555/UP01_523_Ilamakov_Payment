<Page x:Class="UP01_523_Ilamakov_Payment.Pages.UserPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d"
      Title="Мои платежи"
      Background="{StaticResource BackgroundBrush}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <TextBlock Text="Мои платежи"
                   FontSize="22"
                   FontWeight="Bold"
                   Margin="0,0,0,15"
                   Grid.Row="0"/>

        <!-- Панель поиска и фильтрации -->
        <StackPanel Orientation="Horizontal" Grid.Row="1" Margin="0,0,0,15">
            <TextBox x:Name="TextBoxSearch"
                     Width="220"
                     Height="34"
                     ToolTip="Поиск по названию"
                     TextChanged="TextBoxSearch_TextChanged"/>

            <ComboBox x:Name="ComboBoxCategory"
                      Width="180"
                      Height="34"
                      Margin="10,0,0,0"
                      DisplayMemberPath="Name"
                      SelectedValuePath="ID"
                      ToolTip="Фильтр по категории"
                      SelectionChanged="ComboBoxCategory_SelectionChanged"/>

            <Button Content="Сбросить"
                    Width="110"
                    Margin="10,0,0,0"
                    Click="ButtonReset_Click"
                    Background="{StaticResource GrayBrush}"/>
        </StackPanel>

        <!-- Таблица платежей -->
        <DataGrid x:Name="DataGridPayments"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  BorderBrush="{StaticResource PrimaryBrush}"
                  BorderThickness="1">

            <DataGrid.Columns>
                <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="110"/>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="*"/>
                <DataGridTextColumn Header="Категория" Binding="{Binding Category.Name}" Width="140"/>
                <DataGridTextColumn Header="Количество" Binding="{Binding Num}" Width="100"/>
                <DataGridTextColumn Header="Цена" Binding="{Binding Price}" Width="100"/>
                <DataGridTextColumn Header="Сумма" Binding="{Binding Total}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Нижняя панель -->
        <StackPanel Orientation="Horizontal" Grid.Row="3" Margin="0,15,0,0" HorizontalAlignment="Right">
            <Button Content="Сменить пароль"
                    Width="150"
                    Click="ButtonChangePass_Click"
                    Background="{StaticResource AccentBrush}"/>
            <Button Content="Выйти"
                    Width="120"
                    Margin="10,0,0,0"
                    Click="ButtonLogout_Click"
                    Background="{StaticResource DangerBrush}"/>
        </StackPanel>
    </Grid>
</Page>